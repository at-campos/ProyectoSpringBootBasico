<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context
                           http://www.springframework.org/schema/context/spring-context.xsd">

    <context:annotation-config/>

    <bean id="serviceClassBean" class="com.ebac.modulo61.components.ServiceBySetterClass">
        <property name="ModelClass" ref="modelClassBean" />
    </bean>

    <bean id="modelClassBean" class="com.ebac.modulo61.components.ModelClass"/>

    <bean id="serviceByConstructorBean" class="com.ebac.modulo61.components.ServiceByConstructorClass">
        <constructor-arg ref="modelClassBean" />
    </bean>

    <bean id="serviceByAnnotation" class="com.ebac.modulo61.components.ServiceByAnnotationsClass"/>
</beans>